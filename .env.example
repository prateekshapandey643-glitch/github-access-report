# Copy to .env and `export $(cat .env | xargs)` before running, or set these
# as real environment variables / pass as -D system properties however your
# shell/CI prefers. Spring Boot reads all of these via application.yml.

# ---- Server ----
PORT=8080

# ---- Authentication mode: "token" or "app" ----
GITHUB_AUTH_MODE=token

# ---- Option A: Personal Access Token / fine-grained token ----
# Classic PAT scopes: read:org, repo
# Fine-grained token: Organization permissions -> Members (read);
# Repository permissions -> Administration (read), Metadata (read).
GITHUB_TOKEN=

# ---- Option B: GitHub App (recommended for production / org-wide installs) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./private-key-pkcs8.pem
GITHUB_APP_INSTALLATION_ID=

# ---- Behavior ----
GITHUB_DEFAULT_ORG=
GITHUB_MAX_CONCURRENCY=10
GITHUB_MAX_RETRIES=5
GITHUB_RETRY_BASE_DELAY_MS=1000
REPORT_CACHE_TTL_MS=300000
